{
  "name": "thai-tu-fashion-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "SPA Thai Tu Fashion (prototype Claude Design) nối với API Supabase",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i css/tailwind.src.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i css/tailwind.src.css -o css/tailwind.css --watch",
    "build:vendor": "esbuild vendor-src/sentry.js --bundle --minify --format=iife --target=es2019 --legal-comments=none --outfile=vendor/sentry.min.js",
    "start": "npx --yes serve . -l 8080",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.48",
    "@sentry/browser": "^9.47.2",
    "esbuild": "^0.25.12",
    "pg": "^8.23.1",
    "tailwindcss": "^3.4.19"
  }
}
