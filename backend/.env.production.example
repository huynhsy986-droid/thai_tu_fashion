# ===== Production (Supabase Cloud) — sao chép vào biến môi trường của nơi deploy, KHÔNG commit =====
NODE_ENV=production
PORT=4000
TRUST_PROXY=1
AUTH_PROVIDER=supabase
# Supabase Dashboard → Connect → Transaction pooler (6543). Mật khẩu = Database password.
DATABASE_URL=<Supabase Dashboard → Connect → Transaction pooler, cổng 6543, điền Database password>
DATABASE_SSL=true
DATABASE_POOL_MAX=10
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://ceryulbobrlyxckrezts.supabase.co
SUPABASE_ANON_KEY=sb_publishable_JSzQ9dv_Ug9kPvi3qlxr_g_rfHCFc8F
# Để trống: token ES256 xác minh qua JWKS, token HS256 xác minh bằng Supabase Auth (/auth/v1/user).
SUPABASE_JWT_SECRET=
CORS_ORIGINS=https://thai-tu-fashion.onrender.com
RATE_LIMIT_AUTH=20
RATE_LIMIT_API=600
RATE_LIMIT_CONTACT=10

# --- Logging & giám sát (Issue #4, #7) — để trống = tắt ---
# LOG_FORMAT=json|pretty (mặc định: pretty khi dev, json khi production) · LOG_LEVEL=debug|info|warn|error
LOG_LEVEL=info
# Sentry: tạo 2 project (Node.js + Browser JavaScript) trên sentry.io → Settings → Client Keys (DSN)
SENTRY_DSN=
SENTRY_DSN_BROWSER=
SENTRY_TRACES_SAMPLE_RATE=0
# Google Analytics 4: Admin → Data streams → Web → Measurement ID (G-XXXXXXXXXX)
GA_MEASUREMENT_ID=
