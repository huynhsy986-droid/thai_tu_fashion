{
  "name": "thai-tu-fashion-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Thai Tu Fashion REST API trên Supabase",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:reset": "bash ../scripts/db-reset.sh",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "make-admin": "node scripts/make-admin.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "supertest": "^7.3.2",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
