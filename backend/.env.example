# ---------- Chung ----------
NODE_ENV=development
PORT=4000
# Phục vụ frontend tĩnh cùng origin (để trống để tắt)
# STATIC_DIR=../frontend
CORS_ORIGINS=http://localhost:4000,http://localhost:8080

# ---------- Database ----------
# Local (Postgres thường, chạy scripts/db-reset.sh):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/thaitu
# Supabase Cloud (Project Settings → Database → Connection string, Transaction pooler 6543):
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_SSL=true

# ---------- Auth ----------
# local: backend tự ký JWT (dev/CI) · supabase: dùng Supabase Auth
AUTH_PROVIDER=local
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# AUTH_PROVIDER=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon key>
# Legacy JWT secret (HS256). Bỏ trống → xác minh bằng JWKS của dự án.
# SUPABASE_JWT_SECRET=<jwt secret>

RATE_LIMIT_AUTH=20
RATE_LIMIT_API=600
RATE_LIMIT_CONTACT=10

# --- Logging & giám sát (Issue #4, #7) — để trống = tắt ---
# LOG_FORMAT=json|pretty (mặc định: pretty khi dev, json khi production) · LOG_LEVEL=debug|info|warn|error
LOG_LEVEL=info
# Sentry: tạo 2 project (Node.js + Browser JavaScript) trên sentry.io → Settings → Client Keys (DSN)
SENTRY_DSN=
SENTRY_DSN_BROWSER=
SENTRY_TRACES_SAMPLE_RATE=0
# Google Analytics 4: Admin → Data streams → Web → Measurement ID (G-XXXXXXXXXX)
GA_MEASUREMENT_ID=
